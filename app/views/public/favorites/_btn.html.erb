<div id="favorite_buttons_<%= review.id %>">
  <% if review.favorited_by?(current_user) %>
    <%= link_to game_review_favorites_path(review.game, review), method: :delete, remote: true, data: {"turbolinks" => false} do %>
      <i class="fas fa-heart" aria-hidden="true" style="color: red;"></i>
      <%= review.favorites.count %>
    <% end %>
  <% else %>
    <%= link_to game_review_favorites_path(review.game, review), method: :post, remote: true, data: {"turbolinks" => false} do %>
      <i class="fas fa-heart" aria-hidden="true" style="color: gray;"></i>
      <%= review.favorites.count %>
    <% end %>
  <% end %>
</div>

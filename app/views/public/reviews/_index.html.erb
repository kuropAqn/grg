<table class="table table-responsive">

  <thead>
    <tr>
      <th>投稿日時</th>
      <th>タイトル</th>
      <th>本文</th>
      <th>添付画像</th>
      <th></th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% reviews.each do |r| %>
      <tr>
        <td>
        <%= l(r.created_at, format: :short) %>

        </td>
        <td>
          <%= r.title %>
        </td>
        <td>
          <%= r.body %>
        </td>

        <td>
          <% if r.review_image.present? %>
            <%= link_to image_tag(r.review_image, width: 100), game_review_path(r.game_id, r.id) %>
          <% else %>
            <p>画像がありません</p>
          <% end %>
        </td>

        <td style="white-space: nowrap;">
          <%= r.star %>
        </td>

        <td style="white-space: nowrap;"><%= render "public/favorites/btn", review: r %></td>

        <td>
          <%= link_to "詳細", game_review_path(r.game_id, r.id), class: "btn btn-primary w-auto" %>
          <%= link_to "編集", edit_game_review_path(r.game_id, r.id), class: "btn btn-success w-auto" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

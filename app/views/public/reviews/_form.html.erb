<%= form_with model: review, url: review.persisted? ? game_review_path(game, review) : game_reviews_path(game), method: review.persisted? ? :patch : :post do |f| %>

  #☆5評価用
  <div class="form-group position-static">
    <%= f.label :star %>
    <div id="post_raty"></div>
    <% if review.id.nil? %>
    <script>
      var elem = document.querySelector('#post_raty');
      var opt = {
          starOn: "<% asset_path('star-on.png') %>",
          starOff: "<% asset_path('star-off.png') %>",
          starHalf: "<% asset_path('star-half.png') %>",
          scoreName: 'review[star]' };
      raty(elem,opt);
    </script>
    <% else %>
      <%= render "public/reviews/_output_star", review: review %>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: 'form-control' %>
  </div>

  <div class="form-group w-50">
    <%= f.label :body %>
    <%= f.text_area :body, class: 'form-control' %>
  </div>

  <div class="form-group w-50">
  <%= f.label :star %>
  <%= f.number_field :star, in: 1..5, class: 'form-control', autofocus: true %>
</div>

  <div class="form-group w-50">
    <%= f.label :review_image %>
    <%= f.file_field :review_image, class: 'form-control' %>
  </div>
    <div class="btn-group", role="group">
    <%= f.submit btntxt, class: 'btn btn-primary' %>

<% end %>
  <% if review.persisted? %>
    <%= link_to '削除', game_review_path(@game, @review),
                        method: :delete,
                        data: { confirm: 'Are you sure?' },
                        class: 'btn btn-danger' %>
  <% end %>

    <%= link_to 'ゲームへ戻る', game_path(@game), class: "btn btn-secondary" %>
</div>
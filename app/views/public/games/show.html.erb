<div class="container container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card", style="margin-top: 20px;
                                width: 200;">

        <!-- カードのヘッダー -->
        <div class="card-header">
          <h5 class="mb-0"><strong><%= @game.title %></strong></h5>
        </div>

        <!-- カードの中身 -->
        <div class="card-body text-start">
          <%= image_tag @game.game_image, width: 400 %>
        </div>


        <div class="card-body text-start">
          <h6>ゲーム概要</h6>
          <p><%= @game.body %></p>
        </div>
      </div>

      <div class="mt-5">
        <div class="d-flex">
          <h5><%= @game.title %>のレビュー</h5>
          <div class="ml-3">
            <!-- 評価 -->
            <%= render 'public/games/avg_star', score: @review_avg.to_f.round(1), dom_id: "game_avg_star_#{@game.id}" %>
          </div>
          <div class="ml-3"><%= @game.reviews.count %>件</div>
        </div>
        <%= render 'public/reviews/index', reviews: @reviews %>
      </div>

      <div>
        <h5>投稿</h5>
        <% if user_signed_in? %>
          <%= render 'public/reviews/form', review: @review, game: @game, btntxt: @btntxt %>
        <% else %>
          <p>レビューを投稿するには、<%= link_to 'ログイン', new_user_session_path %>してください。</p>
        <% end %>
      </div>

    </div>
  </div>
</div>
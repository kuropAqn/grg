<% @games.each do |game| %>
<div class="col-md-12 mb-3">
  <div class="card shadow-sm p-3">
    <div class="row">

      <!-- 画像 -->
      <div class="col-md-5 d-flex align-items-center justify-content-center">
        <% if game.game_image.attached? %>
          <%= image_tag game.game_image, class: "img-fluid rounded", alt: game.title %>
        <% else %>
          <%= image_tag "no_image.png", class: "img-fluid rounded", alt: "No image" %>
        <% end %>
      </div>

      <!-- 情報 -->
      <div class="col-md-7">
        <div class="card-body">
          <h5 class="card-title">
            <%= link_to game.title, game_path(game) %></h5>
          <p class="card-text"><%= truncate(game.body, length: 80) %></p>
          <p class="card-text"><strong>価格：</strong>￥<%= number_to_currency(game.price) %></p>
            <% review_count = game.reviews.count %>
            <% average_star = game.reviews.average(:star)&.round(1) %>
          <p class="card-text">
            <strong>レビュー：</strong>
            <%= review_count %>件
            <% if average_star.present? %>
                  ★<%= average_star %> / 5
            <% end %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>

<div class="container container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">

      <!-- ユーザー情報 -->
      <div class="card shadow">
        <div class="card-header text-center bg-light">
          <h5 class="mb-0"><strong>ユーザー情報</strong></h5>
        </div>

        <div class="card-body">
          <table class="table table-borderless mb-0">
            <tbody>
              <tr>
                <th scope="row" class="text-muted">ユーザーネーム</th>
                <td><%= @user.name %></td>
              </tr>
              <tr>
                <th scope="row" class="text-muted">メールアドレス</th>
                <td><%= @user.email %></td>
              </tr>
              <tr>
                <th scope="row" class="text-muted">登録日</th>
                <td><%= @user.created_at.strftime("%B %d, %Y") %></td>
              </tr>
              <tr>
                <td><%= link_to 'グラフ表示', graphs_path, class: "btn btn-primary" %></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- 編集ボタン -->
        <div class="card-footer text-end bg-white">
          <%= link_to "編集", information_path, class: "btn btn-success" %>
        </div>
      </div>

      <!-- ユーザーが投稿したレビュー -->
      <div class="mt-4">
        <%= render 'public/reviews/index', reviews: @reviews %>
      </div>
      
    </div>
  </div>
</div>
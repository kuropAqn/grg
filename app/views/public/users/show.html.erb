<div class="container container-fluid">
  <div class="row justify-content-center">
    <div class="col-8">
      <table>
        <tr>
          <th>ユーザーネーム</th>
          <td><%= @user.name %></td>
        </tr>
        <tr>
          <th>メールアドレス</th>
          <td><%= @user.email %></td>
        </tr>
        <tr>
          <th>登録日</th>
          <td><%= @user.created_at.strftime("%B %d, %Y") %></td>
        </tr>
        <tr>
          <td>
            <%= link_to "編集ボタン", information_path, class: "btn btn-primary" %>
          </td>
        </tr>
      </table>
    </div>
  </div>
</div>


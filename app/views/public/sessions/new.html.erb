<div class="container-fluid position-relative">
  <div class="row align-items-center justify-content-center">
    <div class="col-lg-6 col-md-8">

      <h5 class="d-inline-block py-2">ユーザーログイン</h5>
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="field m-3">
            <%= f.label :email, class: "form-label" %><br />
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="field m-3">
            <%= f.label :password, class: "form-label" %><br />
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="field m-3">
              <%= f.check_box :remember_me %>
              <%= f.label :remember_me, class: "form-label" %>
            </div>
          <% end %>

          <div class="actions m-3 d-flex justify-content-between">
            <%= f.submit "ログイン", class: "btn btn-primary" %>
            <%= link_to "新規登録はこちら", new_user_registration_path, class: "btn btn-secondary" %>
          </div>
        <% end %>

    </div>
  </div>
</div>


<div class="container container-fluid">
  <div class="row justify-content-center">
    <div class="col-10">

      <div class="mr-5 my-3">
        <%= render 'admin/genres/form', genre: @genre, btntxt: @btntxt %>
      </div>

      <div class="m-3">
        <h4>ジャンル一覧</h4>
        <table class="table table-bordered">
          <thread>
            <tr>
              <th>No.</th>
              <th>ジャンル名</th>
              <th>操作</th>
            </tr>
          </thread>
          <tbody>
            <% @genres.each do |genre| %>
              <tr>
                <td><%= genre.id %></td>
                <td><%= genre.name %></td>
                <td>
                  <div class="btn-group" role="group">
                    <%= link_to '編集', edit_admin_genre_path(genre), class:'btn btn-success'%>
                    <%= link_to '削除', admin_genre_path(genre), method: :delete, data: { confirm: '本当に削除しますか？' }, class:'btn btn-danger' %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>
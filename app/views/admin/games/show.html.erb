<div class="conteiner-fluid">
  <div class="row justify-content-center">
    <div class="col-8">
      <h1><%= @game.title %></h1>

      <table>
        <tr>
          <td><%= image_tag @game.game_image, width: 400 %></td>
        </tr>
        <tr>
          <td>概要</td>
          <td><%= @game.body %></td>
        </tr>
        <tr>
          <td>価格</td>
          <td><%= @game.price %></td>
        </tr>
        <tr>
          <td>ジャンル</td>
          <td><%= @game.genre.name %></td>
        </tr>
        <tr>
          <td><%= link_to '編集', edit_admin_game_path(@game.id), class: 'btn btn-primary' %></td>
          <td><%= button_to '削除', admin_game_path(@game.id), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger' %></td>
        </tr>
        <tr>
          <td><%= link_to '戻る', admin_games_path, class: 'btn btn-secondary' %></td>
        </tr>
      </table>

    </div>
  </div>
</div>
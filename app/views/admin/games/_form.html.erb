<div class="w-75">
  <%= form_with model: game, url: game.persisted? ? admin_game_path(game) : admin_games_path, method: game.persisted? ? :patch : :post, local: true do |f| %>
    <div class="m-3">
      <%= f.label :game_image, class: "form-label" %>
      <%= f.file_field :game_image, class: "form-control" %>
    </div>
    <div class="m-3">
      <%= f.hidden_field :image_cache %>
    </div>
    <div class="m-3">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>
    <div class="m-3">
      <%= f.label :body, class: "form-label" %>
      <%= f.text_area :body, class: "form-control" %>
    </div>
    <div class="m-3">
      <%= f.label :price, class: "form-label" %>
      <%= f.number_field :price, class: "form-control" %>
    </div>
    <div class="m-3">
      <%= f.label :genre_id, class: "form-label" %>
      <%= f.select :genre_id, Genre.all.map { |g| [g.name, g.id] }, { include_blank: "--選択してください--" }, class: "form-select" %>
    </div>
    <div class="m-4">
      <%= f.submit btntxt, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
<table class="table table-striped">
  <thead>
    <tr>
      <th></th>
      <th>タイトル</th>
      <th>概要</th>
      <th>価格</th>
      <th>ジャンル</th>
    </tr>
  </thead>
  <tbody>
    <% @games.each do |game| %>
      <tr>
        <td><%= link_to admin_game_path(game.id) do %>
              <%= image_tag game.game_image, width: 200 %>
            <% end %>
        </td>
        <td><%= link_to game.title, admin_game_path(game.id) %></td>
        <td><%= game.body %></td>
        <td><%= game.price %></td>
        <td><%= game.genre.name if game.genre %></td>
      </tr>
    <% end %>
  </tbody>
</table>
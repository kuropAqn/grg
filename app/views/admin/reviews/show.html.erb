<div class="container">
  <div class="row">
    <div class="col-md-12">
      <h2>レビュー詳細</h2>
      <table class="table table-striped">
        <tr>
          <th>ID</th>
          <td><%= @review.id %></td>
        </tr>
        <tr>
          <th>User</th>
          <td><%= @review.user.name %></td>
        </tr>
        <tr>
          <th>Rating</th>
          <td><%= @review.star %></td>
        </tr>
        <tr>
          <th>Comment</th>
          <td><%= @review.body %></td>
        </tr>
      </table>

      <%= button_to '削除', admin_review_path, method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger' %>
      <%= link_to 'レビュー一覧へ', admin_reviews_path, class: 'btn btn-secondary' %>

    </div>
  </div>
<div class="container container-fluid">
  <div class="row">
    <div class="col-md-12">
      <h3 class="my-3">レビュー一覧</h3>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>ID</th>
            <th>ユーザー名</th>
            <th>タイトル</th>
            <th>ゲームタイトル</th>
            <th>評価</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @reviews.each do |review| %>
            <tr>
              <td><%= review.id %></td>
              <td><%= review.user.name %></td>
              <td><%= review.game.title %></td>
              <td><%= review.title %></td>
              <td><%= review.star %></td>
              <td>
                <%= link_to '詳細', admin_review_path(review), class: 'btn btn-info' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>
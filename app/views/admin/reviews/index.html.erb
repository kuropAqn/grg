<div class="container container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h5>レビュー一覧</h5>
      <% @reviews.each do |r| %>
        <div class="col-12 mb-3">
          <div class="card shadow-sm">
            <div class="card-body">

              <!-- 1段目：評価・タイトル -->
              <div class="d-flex align-items-start">
                <h5 class="card-title mb-2">
                  <%= link_to r.title, admin_review_path(r) %>
                </h5>
                <p class="ml-3">
                  <%= link_to r.game.title, admin_game_path(r.game) %>
                </p>
              </div>

              <!-- 2段目：本文・画像 -->
              <div class="d-flex align-items-start">
                <p class="card-text mb-2"><%= r.body %></p>
              </div>

              <div class="d-flex">
                <% if r.review_image.present? %>
                  <div><%= image_tag r.review_image, width:100, class:"img-thumbnail" %></div>
                <% end %>
              </div>

              <!-- 3段目：評価・いいね・投稿者・投稿日時 -->
              <div class="d-flex justify-content-end align-items-center text-muted small mb-1">
                <div class="mr-3">
                  <%= render "public/reviews/output_star", review: r %>
                </div>
                <div>
                  <%= render "public/favorites/btn", review: r %>
                </div>

                <div>
                  <%= link_to r.user.name, admin_user_path(r.user_id), class: "text-muted mx-3" %>
                </div>
                <div>
                  <%= l(r.created_at, format: :short) %>
                </div>
              </div>

            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
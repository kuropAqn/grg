<div class="container container-fluid">
  <div class="row">
    <div class="col-12">
      <h3>ユーザー一覧</h3>

      <table class="table table-bordered">
        <thead>
          <tr>
            <th>ユーザー名</th>
            <th>メールアドレス</th>
            <th>登録日</th>
            <th>会員ステータス</th>
            <th>アクション</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td><%= user.created_at.strftime("%Y/%m/%d") %></td>
              <td>
                <% if user.is_active %>
                  <p>有効</p>
                <% else %>
                  <p>退会済み</p>
                <% end %>
              </td>
              <td>
                <div class="btn-group" role="group">
                  <%= link_to '詳細', admin_user_path(user), class: 'btn btn-info' %>
                  <%= link_to '編集', edit_admin_user_path(user), class: 'btn btn-warning' %>
                  <%= link_to '削除', admin_user_path(user), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger' %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>


<h3>ユーザー詳細ページ</h3>
<div>
  <table class="table table-bordered mt-3">
    <tr>
      <th>ID</th>
      <td><%= @user.id %></td>
    </tr>
    <tr>
      <th>ユーザー名</th>
      <td><%= @user.name %></td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><%= @user.email %></td>
    </tr>
    <tr>
      <th>登録日</th>
      <td><%= @user.created_at.strftime("%Y/%m/%d") %></td>
    </tr>
    <tr>
      <th>更新日</th>
      <td><%= @user.updated_at.strftime("%Y/%m/%d") %></td>
    </tr>
    <tr>
      <th>レビュー数</th>
      <td><%= @user.reviews.count %></td>
    </tr>
  </table>

  <div class="btn-group" role="group">
    <%= link_to '戻る', admin_users_path, class: 'btn btn-primary' %>
    <%= link_to '編集', edit_admin_user_path(@user), class: 'btn btn-warning' %>
  </div>
</div>

<h5 class="mt-5">レビュー一覧</h5>
<table class="table table-bordered mt-3">
  <thead>
    <tr>
      <th>ゲームタイトル</th>
      <th>レビュー内容</th>
      <th>評価</th>
      <th>アクション</th>
    </tr>
  </thead>
  <tbody>
    <% @user.reviews.each do |review| %>
      <tr>
        <td><%= review.title %></td>
        <td><%= review.body %></td>
        <td><%= review.star %></td>
        <td>
          <div class="btn-group" role="group">
            <%= link_to '詳細', admin_review_path(review), class: 'btn btn-success' %>
            <%= link_to '削除', admin_review_path(review), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger' %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
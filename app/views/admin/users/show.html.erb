
<h1>ユーザー詳細ページ</h1>
<p>ユーザー名: <%= @user.name %></p>
<p>メールアドレス: <%= @user.email %></p>
<p>登録日: <%= @user.created_at.strftime("%Y/%m/%d") %></p>

<p>レビュー一覧</p>
<table class="table table-bordered">
  <thead>
    <tr>
      <th>ゲームタイトル</th>
      <th>レビュー内容</th>
      <th>評価</th>
      <th>アクション</th>
    </tr>
  </thead>
  <tbody>
    <% @user.reviews.each do |review| %>
      <tr>
        <td><%= review.title %></td>
        <td><%= review.body %></td>
        <td><%= review.star %></td>
        <td>
          <%= link_to '編集', edit_admin_review_path(review), class: 'btn btn-warning' %>
          <%= link_to '削除', admin_review_path(review), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<header class="sticky-top">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid d-flex align-items-center justify-content-between">

      <!-- 左側：ロゴ -->
      <%= link_to root_path, class: "navbar-brand mb-0" do %>
        <%= image_tag 'GRG_logo.png', width: 125, height: 50, class: "img-resize rounded" %>
      <% end %>

      <!-- 右側：トグルボタン -->
      <div class="d-flex flex-column align-items-end">

        <!-- トグルボタン -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown"
          aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- ナビゲーションメニュー -->
        <div class="collapse navbar-collapse justify-content-end mt-2" id="navbarNavDropdown">
          <ul class="navbar-nav d-flex align-items-end">

            <% if admin_signed_in? %>
              <li><%= link_to admin_games_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-gamepad"></i> ゲーム一覧
              <% end %></li>
              <li><%= link_to admin_users_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-users"></i> 会員一覧
              <% end %></li>
              <li><%= link_to admin_reviews_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-list-check"></i> レビュー一覧
              <% end %></li>
              <li><%= link_to admin_genres_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-shapes"></i> ジャンル一覧
              <% end %></li>
              <li><%= button_to destroy_admin_session_path, method: :delete, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-right-from-bracket"></i> 管理者ログアウト
              <% end %></li>


            <% elsif user_signed_in? %>
              <li><%= link_to mypage_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-user"></i> マイページ
              <% end %></li>
              <li><%= link_to games_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-gamepad"></i> ゲーム一覧
              <% end %></li>
              <li><%= button_to destroy_user_session_path, method: :delete, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-right-from-bracket"></i> ログアウト
              <% end %></li>

            <% else %>
              <li><%= link_to about_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-g"></i> About
              <% end %></li>
              <li><%= link_to games_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-gamepad"></i> ゲーム一覧
              <% end %></li>
              <li><%= link_to new_user_registration_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-user-plus"></i> 新規登録
              <% end %></li>
              <li><%= link_to new_user_session_path, class: 'btn btn-outline-secondary mx-1 my-1' do %>
                <i class="fa-solid fa-right-to-bracket"></i> ログイン
              <% end %></li>
            <% end %>
          </ul>
        </div>

        <!-- 検索フォーム -->
        <div class="mt-1">
          <%= form_with url: search_path, method: :get, local: true, html: { class: 'd-flex', role: 'search' } do |f| %>
            <%= f.text_field :query, required: true, class: 'form-control me-2', placeholder: '検索ワード', style: 'width: auto;' %>
            <% if admin_signed_in? %>
              <%= f.select :search_type, [['ユーザー', 'User'], ['ゲーム', 'Game'], ['ジャンル', 'Genre']], {}, class: 'form-select me-2' %>
            <% else %>
              <%= f.select :search_type, [['ゲーム', 'Game'], ['ジャンル', 'Genre']], {}, class: 'form-select me-2' %>
            <% end %>

            <%= f.hidden_field :match_type, value: 'partial' %>
            <%= f.submit "検索", class: 'btn btn-outline-light' %>
          <% end %>
        </div>
      </div>

    </div>

    
    
  </nav>
</header>

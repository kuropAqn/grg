<div class='container'>
  <div class="row">
    <% if @search_type == 'User' %>
      <h4 class="d-inline-block p-2 m-4", style="background-color: #e0e0e0; color: #333;">
        ユーザー名に"<%= @query %>"を含むユーザーを検索
      </h4>
    <% elsif @search_type == 'Game' %>
      <h4 class="d-inline-block p-2 m-4" style="background-color: #e0e0e0; color: #333;">
        タイトルに"<%= @query %>" を含むゲームを検索
      </h4>
    <% else %>
      <h4 class="d-inline-block p-2 m-4" style="background-color: #e0e0e0; color: #333;">
        ジャンルが "<%= @query %>"のゲームを検索
      </h4>
    <% end %>
  </div>
  <div class="row">
    <div class="col-md-12">
      <% if @results.any? %>
        <table class ="table">
          <!-- 会員についての検索結果 -->
          <% if @search_type == 'User' %>
            <thead style="background-color: #f1f1f1; color: #333;">
              <tr>
                <th>会員ID</th>
                <th>ニックネーム</th>
                <th>メールアドレス</th>
                <th>ステータス</th>
              </tr>
            </thead>
            <tbody>
              <% @results.each do |result| %>
                <tr>
                  <td>
                    <%= result.id %>
                  </td>
                  <td>
                    <%= link_to "#{result.name}", admin_user_path(result), class: 'text-dark' %>
                  </td>
                  <td>
                    <%= result.email %>
                  </td>
                  <td class="<%= result.is_active ? 'text-success font-weight-bold' : 'text-muted font-weight-bold' %>">
                    <%= result.is_active ? '有効' : '退会' %>
                  </td>
                </tr>
              <% end %>
            </tbody>

          <!-- ゲームについての検索結果 -->
          <% elsif @search_type == 'Game' %>
            <!-- 管理者ログイン時 -->
            <% if admin_signed_in? %>
              <thead style="background-color: #f1f1f1; color: #333;">
                <tr>
                  <th>ゲームID</th>
                  <th>タイトル</th>
                  <th>税抜価格</th>
                  <th>ジャンル</th>
                </tr>
              </thead>
              <tbody>
                <% @results.each do |result| %>
                  <tr>
                    <td class="align-middle">
                      <%= result.id %>
                    </td>
                    <td class="align-middle">
                      <%= link_to admin_game_path(result.id), class: 'text-dark' do %>
                        <%= result.title %>
                      <% end %>
                    </td>
                    <td class="align-middle">
                      <%= result.price.to_s(:delimited) %>
                    </td>
                    <td class="align-middle">
                      <%= result.genre.name %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            <!-- 会員ログインまたは未ログイン時 -->
            <% else %>
              <thead style="background-color: #f1f1f1; color: #333;">
                <tr>
                  <th>タイトル</th>
                  <th>概要</th>
                  <th>ジャンル</th>
                  <th style="white-space: nowrap;">税込価格</th>
                </tr>
              </thead>
              <tbody>
                <% @pub_results.each do |result| %>
                  <tr>
                    <td style="white-space: nowrap;">
                      <%= image_tag result.game_image, width:"75" %>
                      <%= link_to result.title, game_path(result.id) %>
                    </td>
                    <td>
                      <%= result.body %>
                    </td>
                    <td>
                      <%= result.genre.name %>
                    </td>
                    <td>
                      <%= result.price.to_s(:delimited) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            <% end %>
          <!-- ジャンルに紐づいたゲームの検索結果 -->
          <% elsif  @search_type == 'Genre' %>
            <!-- 管理者ログイン時 -->
            <% if admin_signed_in? %>
              <thead style="background-color: #f1f1f1; color: #333;">
                <tr>
                  <th>ゲームID</th>
                  <th>タイトル</th>
                  <th>税抜価格</th>
                </tr>
              </thead>
              <tbody>
                <% @results.games.each do |result| %>
                  <tr>
                    <td class="align-middle">
                      <%= result.id %>
                    </td>
                    <td class="align-middle">
                      <%= link_to admin_game_path(result.id), class: 'text-dark' do %>
                        <%= result.title %>
                      <% end %>
                    </td>
                    <td class="align-middle">
                      <%= result.price.to_s(:delimited) %>
                    </td>
                  </tr>
                  <% end %>
              </tbody>
            <!-- 会員ログインまたは未ログイン時 -->
            <% else %>
              <thead style="background-color: #f1f1f1; color: #333;">
                <tr>
                  <th>タイトル</th>
                  <th>概要</th>
                  <th>税込価格</th>
                </tr>
              </thead>
              <tbody>
                <% @results.each do |result| %>
                  <tr>
                    <td style="white-space: nowrap;">
                      <%= image_tag result.game_image, width:"75" %>
                      <%= link_to result.title, game_path(result.id) %>
                    </td>
                    <td>
                      <%= result.body %>
                    </td>
                    <td>
                      <%= result.price.to_s(:delimited) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            <% end %>
          <% end %>
        </table>
      <% else %>
        <p>該当する結果は見つかりませんでした。</p>
      <% end %>
    </div>
  </div>
</div>